{
  "name": "@pipr/docs",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "bun run typegen && NODE_OPTIONS=--localstorage-file=.cache/node-localstorage vite dev",
    "build": "bun run typegen && bun run build:generated",
    "build:generated": "bun scripts/build.ts",
    "build:vite": "NODE_OPTIONS=--localstorage-file=.cache/node-localstorage vite build",
    "preview": "mkdir -p .cache && NODE_OPTIONS=--localstorage-file=.cache/node-localstorage vite preview",
    "recipes:sync": "bun scripts/sync-recipes.ts",
    "recipes:check": "bun scripts/sync-recipes.ts --check",
    "content:check": "bun scripts/check-content.ts",
    "links:check": "bun scripts/check-content.ts --external",
    "test": "bun run typegen && bun run test:generated",
    "test:generated": "bun run recipes:check && bun run content:check && bun test scripts/tests src",
    "test:browser": "playwright test",
    "typegen": "mkdir -p .cache && NODE_OPTIONS=--localstorage-file=.cache/node-localstorage fumadocs-mdx && tsr generate",
    "typecheck": "bun run typegen && bun run typecheck:generated",
    "typecheck:generated": "bun ../../node_modules/typescript/bin/tsc --noEmit",
    "lint": "biome lint .",
    "format:check": "biome format .",
    "check": "bun run recipes:check && bun run content:check && bun run lint && bun run typecheck",
    "postinstall": "bun run typegen"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "@orama/orama": "3.1.18",
    "@takumi-rs/image-response": "2.14.0",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "@tanstack/start-static-server-functions": "1.167.40",
    "copy-to-clipboard": "4.0.2",
    "fumadocs-core": "16.12.1",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.12.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.41",
    "@types/mdx": "2.0.14",
    "@types/node": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@usepipr/runtime": "workspace:*",
    "@vitejs/plugin-react": "6.1.2",
    "fumadocs-twoslash": "3.3.0",
    "fumadocs-typescript": "5.3.0",
    "happy-dom": "20.14.6",
    "nitro": "3.0.260903-beta",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
