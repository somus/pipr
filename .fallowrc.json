{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignoreDependencies": ["collections"],
  "entry": [
    ".pipr/config.ts",
    "packages/cli/src/main.ts",
    "packages/sdk/src/index.ts",
    "packages/runtime/src/index.ts",
    "packages/runtime/src/agent-worker/main.ts",
    "packages/runtime/src/agent-worker/scripted-provider.ts",
    "packages/evals/src/prompt-evals.eval.ts",
    "packages/evals/src/run-local-review.ts",
    "packages/evals/evalite.config.ts",
    "scripts/act-action-fixture.ts"
  ],
  "dynamicallyLoaded": [
    "packages/runtime/src/agent-worker/tests/fixtures/*.ts",
    "packages/evals/src/scripted-provider.ts",
    "packages/e2e/scripted-provider.ts"
  ],
  "usedClassMembers": [{ "implements": "CredentialStore", "members": ["list", "delete"] }],
  "health": {
    "ignore": ["packages/runtime/src/agent-worker/tests/fixtures/**"]
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    ".turbo/**",
    "node_modules/**",
    "apps/docs/.source/**",
    "apps/docs/.output/**",
    "apps/docs/src/routeTree.gen.ts"
  ],
  "workspaces": {
    "patterns": ["apps/*", "packages/*"]
  },
  "duplicates": {
    "ignore": [
      "**/dist/**",
      "**/coverage/**",
      "apps/docs/.source/**",
      "apps/docs/.output/**",
      "apps/docs/src/routeTree.gen.ts"
    ]
  }
}
